DEBUG=1
DB_ENGINE=sqlite
# Set DB_ENGINE=mysql to connect to MySQL:
MYSQL_DATABASE=talentforge
MYSQL_USER=talentforge
MYSQL_PASSWORD=change-this-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# Optional: resume text is sent to OpenAI only when both settings are enabled.
ENABLE_AI_FEEDBACK=0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# Required when DEBUG=0:
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Dedicated JD analysis / interview preparation uses this model.
CAREER_AI_MODEL=gpt-5.6-terra